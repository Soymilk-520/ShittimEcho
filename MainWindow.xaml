<Window x:Class="ShittimEcho.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="Nyaruru Fishy Fight"
        Width="1280"
        Height="720"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        ResizeMode="NoResize"
        Background="Black">
    <Window.Resources>

        <!-- ===================================== -->
        <!-- NYARURU TERMINAL THEME          -->
        <!-- ===================================== -->


        <!-- 主终端蓝 -->
        <SolidColorBrush x:Key="TerminalBlue"
                     Color="#8B3A62"/>


        <!-- 辅助蓝 -->
        <SolidColorBrush x:Key="TerminalLightBlue"
                     Color="#C97A9A"/>


        <!-- 统一亚克力玻璃面板：左侧 / 右侧 / 底部 HUD 使用同一材质深度 -->
        <LinearGradientBrush x:Key="TerminalAcrylicPanel" StartPoint="0,0" EndPoint="0,1">
            <!-- 降低蓝色饱和度，以冰白 / 极浅蓝为主体，仅保留少量粉紫层次 -->
            <GradientStop Color="#E982B0F1" Offset="0"/>
            <GradientStop Color="#DD78A8E9" Offset="0.46"/>
            <GradientStop Color="#D872A0E5" Offset="0.78"/>
            <GradientStop Color="#D0709CE0" Offset="1"/>
        </LinearGradientBrush>

        <!-- 亚克力玻璃边缘 -->
        <SolidColorBrush x:Key="TerminalAcrylicBorder" Color="#F4B8D4FF"/>

        <!-- 保留旧资源名，避免其他界面引用失效 -->
        <SolidColorBrush x:Key="TerminalGlassPanel" Color="#725B6A80"/>
        <SolidColorBrush x:Key="TerminalGlassBorder" Color="#F4B8D4FF"/>

        <!-- 亚克力面板的柔和外发光 -->
        <DropShadowEffect x:Key="TerminalAcrylicShadow"
                          Color="#F08AB8FF"
                          BlurRadius="16"
                          ShadowDepth="0"
                          Opacity="0.12"/>


        <!-- 系统高亮 -->
        <SolidColorBrush x:Key="TerminalAccent"
                     Color="#FF6B9D"/>


        <!-- 在线状态 -->
        <SolidColorBrush x:Key="TerminalOnline"
                     Color="#25D7A3"/>


        <!-- 在线状态文字：比状态灯更深，确保浅色背景下清晰可读 -->
        <SolidColorBrush x:Key="TerminalOnlineText"
                     Color="#A84A6A"/>


        <!-- 警告状态 -->
        <SolidColorBrush x:Key="TerminalWarning"
                     Color="#FFB88A"/>

        <!-- 状态呼吸灯：轻微亮度起伏，不闪烁、不改变颜色 -->
        <Style x:Key="TerminalStatusDotStyle" TargetType="{x:Type Ellipse}">
            <Setter Property="Opacity" Value="0.72"/>
            <Style.Triggers>
                <EventTrigger RoutedEvent="Loaded">
                    <BeginStoryboard>
                        <Storyboard RepeatBehavior="Forever" AutoReverse="True">
                            <DoubleAnimation
                                Storyboard.TargetProperty="Opacity"
                                From="0.72"
                                To="1.0"
                                Duration="0:0:0.8"/>
                        </Storyboard>
                    </BeginStoryboard>
                </EventTrigger>
            </Style.Triggers>
        </Style>




        <!-- 咸鱼喵喵风格协议开关：保留原 CheckBox 的 IsChecked 行为，仅优化尺寸与等间距视觉 -->
        <Style x:Key="ShittimProtocolToggleStyle" TargetType="{x:Type CheckBox}">
            <Setter Property="Width" Value="58"/>
            <Setter Property="Height" Value="22"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type CheckBox}">
                        <Border x:Name="ToggleBorder"
                                Background="#F42080FF"
                                BorderBrush="#F07AA8"
                                BorderThickness="1"
                                CornerRadius="11">
                            <Grid Margin="5,0">
                                <TextBlock x:Name="ToggleText"
                                           Text="OFF"
                                           Foreground="#8A4A6A"
                                           FontSize="8"
                                           FontWeight="SemiBold"
                                           VerticalAlignment="Center"
                                           HorizontalAlignment="Left"/>
                                <Ellipse x:Name="ToggleThumb"
                                         Width="12"
                                         Height="12"
                                         Fill="#D0B0C0"
                                         HorizontalAlignment="Right"
                                         VerticalAlignment="Center"/>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="ToggleBorder" Property="Background" Value="#C5396BFF"/>
                                <Setter TargetName="ToggleBorder" Property="BorderBrush" Value="#FF6B9D"/>
                                <Setter TargetName="ToggleText" Property="Text" Value="ON"/>
                                <Setter TargetName="ToggleText" Property="Foreground" Value="#A84A6A"/>
                                <Setter TargetName="ToggleThumb" Property="Fill" Value="#FF6B9D"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ToggleBorder" Property="BorderThickness" Value="1.5"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="ToggleBorder" Property="Opacity" Value="0.45"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ===================================== -->
        <!-- NYARURU TERMINAL BUTTON         -->
        <!-- ===================================== -->


        <Style x:Key="BlueArchiveButtonStyle"
           TargetType="{x:Type Button}">


            <!-- 鼠标 -->
            <Setter Property="Cursor"
                Value="Hand"/>


            <!-- 内容居中 -->
            <Setter Property="HorizontalContentAlignment"
                Value="Center"/>


            <Setter Property="VerticalContentAlignment"
                Value="Center"/>


            <!-- 内边距 -->
            <Setter Property="Padding"
                Value="12,5"/>


            <!-- 字体 -->
            <Setter Property="FontWeight"
                Value="SemiBold"/>



            <Setter Property="Template">

                <Setter.Value>

                    <ControlTemplate TargetType="{x:Type Button}">


                        <Border x:Name="ButtonBorder"

                            Background="{TemplateBinding Background}"

                            BorderBrush="{TemplateBinding BorderBrush}"

                            BorderThickness="1"

                            CornerRadius="8"

                            SnapsToDevicePixels="True">


                            <Grid>


                                <ContentPresenter

                                HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"

                                VerticalAlignment="{TemplateBinding VerticalContentAlignment}"

                                Margin="{TemplateBinding Padding}"/>


                            </Grid>


                        </Border>



                        <ControlTemplate.Triggers>


                            <!-- 鼠标悬停 -->

                            <Trigger Property="IsMouseOver"
                                 Value="True">


                                <Setter TargetName="ButtonBorder"
                                    Property="BorderBrush"
                                    Value="{StaticResource TerminalAccent}"/>


                                <Setter TargetName="ButtonBorder"
                                    Property="Opacity"
                                    Value="0.9"/>


                            </Trigger>



                            <!-- 点击 -->

                            <Trigger Property="IsPressed"
                                 Value="True">


                                <Setter TargetName="ButtonBorder"
                                    Property="Opacity"
                                    Value="0.65"/>


                            </Trigger>



                            <!-- 禁用 -->

                            <Trigger Property="IsEnabled"
                                 Value="False">


                                <Setter TargetName="ButtonBorder"
                                    Property="Opacity"
                                    Value="0.4"/>


                            </Trigger>


                        </ControlTemplate.Triggers>



                    </ControlTemplate>


                </Setter.Value>


            </Setter>


        </Style>


    </Window.Resources>

    <Grid x:Name="RootGrid" Background="Black">

        <Image x:Name="TerminalBackgroundImage"
               Source="/ShittimBackground.png"
               Stretch="UniformToFill"
               HorizontalAlignment="Stretch"
               VerticalAlignment="Stretch"
               IsHitTestVisible="False"
               Opacity="0"
               Panel.ZIndex="0"/>

        <Grid x:Name="AuthenticationView"
