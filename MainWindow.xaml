                         Opacity="0"/>

                <Ellipse x:Name="Particle3"
                         Width="2"
                         Height="2"
                         Fill="#B07A90"
                         Canvas.Left="430"
                         Canvas.Top="205"
                         Opacity="0"/>

                <Ellipse x:Name="Particle4"
                         Width="1.5"
                         Height="1.5"
                         Fill="#C5A0B5"
                         Canvas.Left="850"
                         Canvas.Top="175"
                         Opacity="0"/>

                <Ellipse x:Name="Particle5"
                         Width="2"
                         Height="2"
                         Fill="#B07A90"
                         Canvas.Left="1010"
                         Canvas.Top="215"
                         Opacity="0"/>

                <Ellipse x:Name="Particle6"
                         Width="1.5"
                         Height="1.5"
                         Fill="#C5A0B5"
                         Canvas.Left="1080"
                         Canvas.Top="420"
                         Opacity="0"/>

                <Ellipse x:Name="Particle7"
                         Width="2"
                         Height="2"
                         Fill="#B07A90"
                         Canvas.Left="225"
                         Canvas.Top="510"
                         Opacity="0"/>

                <Ellipse x:Name="Particle8"
                         Width="1.5"
                         Height="1.5"
                         Fill="#C5A0B5"
                         Canvas.Left="440"
                         Canvas.Top="560"
