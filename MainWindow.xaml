                         StrokeThickness="1.5"/>

                <Ellipse Width="68"
                         Height="68"
                         HorizontalAlignment="Center"
                         VerticalAlignment="Center"
                         Stroke="#B8FFFFFF"
                         StrokeThickness="1"/>

                <Polygon Points="54,8 100,54 54,100 8,54"
                         Stroke="White"
