                          HorizontalAlignment="Center"
                          VerticalAlignment="Center">

                        <Border Background="#C8A8B5"
                                CornerRadius="3.5"/>

                        <Border x:Name="LoadingBarFill"
                                Width="0"
                                Height="5"
                                VerticalAlignment="Center"
                                HorizontalAlignment="Left"
                                Background="#8B3A62"
                                CornerRadius="2.5"/>

                    </Grid>

                    <Border Width="48"
                            Height="20"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
