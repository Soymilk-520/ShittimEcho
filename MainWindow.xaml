                                 Width="3"
                                 Height="3"
                                 Fill="#8B3A62"
                                 Canvas.Left="10"
                                 Canvas.Top="8"
                                 Opacity="0"/>

                        <Ellipse x:Name="TipParticle4"
                                 Width="2"
                                 Height="2"
