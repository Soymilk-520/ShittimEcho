                        <TextBlock x:Name="LoadingMessage3"
                                   Text="正在同步喵喵音频回路……"
                                   Foreground="#8B3A62"
                                   FontSize="16"
                                   FontWeight="SemiBold"
                                   VerticalAlignment="Center"
                                   Margin="22,0,0,0"
                                   Opacity="0"/>

                    </Grid>

                    <Grid Height="32">

                        <Ellipse x:Name="LoadingDot4"
                                 Width="5"
                                 Height="5"
                                 Fill="#8B3A62"
                                 HorizontalAlignment="Left"
                                 VerticalAlignment="Center"
                                 Margin="2,0,0,0"
                                 Opacity="0"/>

                        <TextBlock x:Name="LoadingMessage4"
                                   Text="正在检索喵喵资料……"
                                   Foreground="#8B3A62"
                                   FontSize="16"
                                   FontWeight="SemiBold"
                                   VerticalAlignment="Center"
                                   Margin="22,0,0,0"
                                   Opacity="0"/>

                    </Grid>

                    <Grid Height="32">

                        <Ellipse x:Name="LoadingDot5"
                                 Width="5"
