                           FontSize="17"
                           FontWeight="SemiBold"
                           TextAlignment="Center"
                           HorizontalAlignment="Center"
                           Margin="0,24,0,0"
                           Opacity="0"
                           RenderTransformOrigin="0.5,0.5">

                    <TextBlock.RenderTransform>
                        <TranslateTransform x:Name="FinalLoadingTextTransform"
                                            X="0"
                                            Y="0"/>
                    </TextBlock.RenderTransform>

