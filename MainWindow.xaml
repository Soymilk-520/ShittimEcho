        <!-- 欢迎界面 -->
        <Grid x:Name="WelcomeView"
              Background="Black"
              Visibility="Collapsed"
              Opacity="0"
              Panel.ZIndex="2">

            <Ellipse x:Name="WelcomeGlow"
                     Width="460"
                     Height="460"
                     HorizontalAlignment="Center"
                     VerticalAlignment="Center"
                     Fill="#7A2B4A"
                     Opacity="0"/>

            <TextBlock x:Name="WelcomeText"
                       Text="欢迎回来，老师"
                       Foreground="White"
                       FontSize="35"
                       FontWeight="SemiBold"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center"
                       Opacity="0"/>

        </Grid>

        <!-- 主配置界面 -->
        <Grid x:Name="ConfigurationView"
              Background="Black"
              Visibility="Collapsed"
              Opacity="0"
              Panel.ZIndex="3">

            <Image x:Name="MainConfigurationBackground"
                   Source="/ShittimMainBackground.jpg"
                   Stretch="Fill"
                   HorizontalAlignment="Stretch"
                   VerticalAlignment="Stretch"
                   IsHitTestVisible="False"/>

            <Rectangle Fill="#260B1838"
                       IsHitTestVisible="False"/>


            <!-- ================================================= -->
            <!-- 喵喵移动控制终端                                 -->
            <!-- 顶部中央专用窗口拖动区域。                           -->
            <!-- ================================================= -->
            <Border x:Name="WindowMoveControlTerminal"
                    Width="620"
                    Height="54"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Top"
                    Margin="0,10,0,0"
                    Panel.ZIndex="20"
                    Background="#F4E0EAF8"
                    BorderBrush="#E8FFFFFF"
                    BorderThickness="1"
                    CornerRadius="27"
                    Cursor="SizeAll"
                    MouseLeftButtonDown="WindowMoveControlTerminal_MouseLeftButtonDown"
                    ToolTip="按住此处移动窗口">

                <StackPanel HorizontalAlignment="Center"
                            VerticalAlignment="Center">

                    <TextBlock Text="喵喵移动控制终端"
                               Foreground="#8B3A62"
                               FontSize="12"
                               FontWeight="SemiBold"
                               HorizontalAlignment="Center"/>

                    <TextBlock Text="NYARURU · MOVEMENT CONTROL"
                               Foreground="#9A5070"
                               FontSize="8"
                               FontWeight="SemiBold"
                               HorizontalAlignment="Center"
                               Margin="0,2,0,0"/>

                </StackPanel>
            </Border>

            <Grid Margin="18,14,18,14"
                  Panel.ZIndex="1">

                <Grid.RowDefinitions>
                    <RowDefinition Height="54"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="88"/>
                    <RowDefinition Height="44"/>
                </Grid.RowDefinitions>

                <!-- 顶部标题 -->
                <Grid Grid.Row="0">

                    <StackPanel VerticalAlignment="Top">

                        <TextBlock Text="咸鱼喵喵 · 喵露露终端"
                                   Foreground="#7A2B4A"
                                   FontSize="26"
                                   FontWeight="SemiBold"/>

                        <TextBlock Text="NYARURU : FISHY FIGHT"
                                   Foreground="#7E3558"
                                   FontSize="9"
                                   FontWeight="SemiBold"
                                   Margin="1,2,0,0"/>

                    </StackPanel>

                    <Border HorizontalAlignment="Right"
                            VerticalAlignment="Top"
                            Background="#D9FFFFFF"
                            BorderBrush="#F0FFFFFF"
                            BorderThickness="1"
                            CornerRadius="15"
                            Padding="13,5">

                        <StackPanel Orientation="Horizontal">

                            <Ellipse Width="7"
                                     Height="7"
                                     Fill="#8B3A62"
                                     VerticalAlignment="Center"
                                     Margin="0,0,7,0"/>

                            <TextBlock Text="SYSTEM ONLINE"
                                       Foreground="#7A2B4A"
                                       FontSize="10"
                                       FontWeight="SemiBold"
                                       VerticalAlignment="Center"/>

                        </StackPanel>

                    </Border>

                </Grid>

                <!-- 中央控制区域 -->
                <Grid Grid.Row="1"
                      Margin="0,4,0,4">

                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="440"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- 左侧：音乐 / 语音 / 音频控制 -->
                    <StackPanel Grid.Column="0"
                                Width="440"
                                HorizontalAlignment="Left"
                                VerticalAlignment="Top">

                        <!-- 音乐控制 -->
                        <Border Height="150"
        Background="{StaticResource TerminalAcrylicPanel}"
        BorderBrush="{StaticResource TerminalAcrylicBorder}"
        Effect="{StaticResource TerminalAcrylicShadow}"
        BorderThickness="1"
        CornerRadius="12"
        Padding="18,10"
        Margin="0,0,0,8">


                            <Grid>


                                <Grid.RowDefinitions>

                                    <RowDefinition Height="Auto"/>

